@model Lesson2.Model.Cat

<div class="d-flex justify-content-center">
    <div class="card" style="width: 18rem;">
        <img class="card-img-top" src="@Model.PhotoSrc" alt="@Model.Name">
        <div class="card-body">
            <p class="card-text">Имя: @Model.Name</p>
            <p class="card-text">Дата рождения: @Model.DateOfBirth</p>
            <p class="card-text">Описание: @Model.Description</p>
            <p class="card-text">Порода: @Model.Breed.Name</p>
        </div>
    </div>
</div>