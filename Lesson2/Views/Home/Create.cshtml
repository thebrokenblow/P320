@model Lesson2.ViewModel.CreateCatViewModel


<h1>Создать</h1>

<form method="post">
    <div class="form-group">
        <label>Имя котика: </label>
        <input asp-for="@Model.Cat.Name" type="text" class="form-control" placeholder="Имя котика">
        
        @if (Model.ErrorsByProperty.ContainsKey("Name"))
        {
            @foreach (var error in Model.ErrorsByProperty["Name"])
            {
                <small class="form-text text-danger">@error</small>
            }
        }
    </div>

    <div class="form-group">
        <label>Описание котика: </label>
        <input asp-for="@Model.Cat.Description" type="text" class="form-control" placeholder="Описание котика">
        
        @if (Model.ErrorsByProperty.ContainsKey("Description"))
        {
            @foreach (var error in Model.ErrorsByProperty["Description"])
            {
                <small class="form-text text-danger">@error</small>
            }
        }
    </div>

    <div class="form-group">
        <label>Возраст котика: </label>
        <input asp-for="@Model.Cat.DateOfBirth" type="date" class="form-control" placeholder="Возраст котика">
    </div>

    <div class="form-group">
        <label>Ссылка на фотографию котика: </label>
        <input asp-for="@Model.Cat.PhotoSrc" type="text" class="form-control" placeholder="Ссылка на фотографию котика">
    </div>

    <div class="form-group">
        <label>Порода: </label>
        <select asp-for="@Model.Cat.BreedId" asp-items="@Model.Breeds"></select>
    </div>

    <input asp-for="@Model.Breeds" type="hidden">

    <input type="submit" class="btn btn-primary" value="Создать" />
</form>