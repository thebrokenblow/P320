@model Lesson2.ViewModel.EditCatViewModel


<h1>Редактировать</h1>

<form method="post">
    <input asp-for="@Model.Cat.Id" type="hidden">

    <div class="form-group">
        <label>Имя котика: </label>
        <input asp-for="@Model.Cat.Name" type="text" class="form-control" placeholder="Имя котика">
    </div>

    <div class="form-group">
        <label>Описание котика: </label>
        <input asp-for="@Model.Cat.Description" type="text" class="form-control" placeholder="Описание котика">
    </div>

    <div class="form-group">
        <label>Возраст котика: </label>
        <input asp-for="@Model.Cat.Age" type="number" class="form-control" placeholder="Возраст котика">
    </div>

    <div class="form-group">
        <label>Ссылка на фотографию котика: </label>
        <input asp-for="@Model.Cat.PhotoSrc" type="text" class="form-control" placeholder="Ссылка на фотографию котика">
    </div>

    <div class="form-group">
        <label>Порода: </label>
        <select asp-for="@Model.Cat.BreedId">
            @for (int i = 0; i < Model.Breeds.Count; i++)
            {
                <option value="@Model.Breeds[i].Id">@Model.Breeds[i].Name</option>
            }
        </select>
    </div>

    <input type="submit" class="btn btn-primary" value="Сохранить" />
</form>