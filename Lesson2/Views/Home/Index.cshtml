@model List<Lesson2.Model.Cat>

<div class="container mt-4">
    <div class="row g-4">
        @foreach (var cat in Model)
        {
            <div class="col-md-6 col-lg-4 col-xl-3">
                <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                    <img class="card-img-top" src="@cat.PhotoSrc" alt="@cat.Name" style="height: 200px; object-fit: cover;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold">@cat.Name</h5>
                        <p class="card-text text-muted cat-age">
                            <i class="bi bi-calendar-heart"></i> Возраст: @cat.Age лет
                        </p>
                        <p class="card-text flex-grow-1">@cat.Description</p>
                        <a asp-controller="Home" asp-action="Details" asp-route-id="@cat.Id" class="btn btn-outline-primary mt-2 rounded-pill">
                            Подробнее →
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>